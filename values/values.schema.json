{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["domain", "hsts", "ports"],
  "properties": {
    "domain": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,53}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$"
    },
    "hsts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxAge"],
      "properties": {
        "maxAge": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ports": {
      "type": "object",
      "additionalProperties": false,
      "required": ["serviceType", "pool"],
      "properties": {
        "serviceType": {
          "enum": ["LoadBalancer", "NodePort"]
        },
        "pool": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": { "type": "integer", "minimum": 1024, "maximum": 65535 },
            "end": { "type": "integer", "minimum": 1024, "maximum": 65535 }
          }
        }
      }
    }
  }
}
